enum StatusCte {
  RASCUNHO
  VALIDANDO
  VALIDADO
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  CANCELADO
}

enum TipoCte {
  NORMAL
  COMPLEMENTAR
  SUBSTITUTO
}

enum TipoServicoCte {
  NORMAL
  SUBCONTRATACAO
  REDESPACHO
  REDESPACHO_INTERMEDIARIO
  SERVICO_VINCULADO_MULTIMODAL
}

enum ModalCte {
  RODOVIARIO
}

enum PapelParticipanteCte {
  REMETENTE
  EXPEDIDOR
  RECEBEDOR
  DESTINATARIO
  TOMADOR_OUTROS
}

enum TomadorServicoCte {
  REMETENTE
  EXPEDIDOR
  RECEBEDOR
  DESTINATARIO
  OUTROS
}

enum UnidadeMedidaCte {
  METRO_CUBICO
  QUILOGRAMA
  TONELADA
  UNIDADE
  LITRO
  MMBTU
}

enum GrupoIcmsCte {
  ICMS00
  ICMS20
  ICMS45
  ICMS60
  ICMS90
  ICMS_OUTRA_UF
  ICMSSN
}

enum TipoEventoCte {
  CANCELAMENTO
  CARTA_CORRECAO
  VINCULACAO_PAGAMENTO
}

enum StatusEventoCte {
  PENDENTE
  AUTORIZADO
  REJEITADO
}

model ConhecimentoTransporte {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  numero Int
  serie  Int @default(1)

  modelo String @default("57")

  status      StatusCte      @default(RASCUNHO)
  tipoCte     TipoCte        @default(NORMAL)
  tipoServico TipoServicoCte @default(NORMAL)
  modal       ModalCte       @default(RODOVIARIO)

  dataEmissao DateTime @default(now())

  cfop             String
  naturezaOperacao String

  codigoMunicipioEnvio String
  municipioEnvio       String
  ufEnvio              String

  codigoMunicipioInicio String
  municipioInicio       String
  ufInicio              String

  codigoMunicipioFim String
  municipioFim       String
  ufFim              String

  tomadorServico TomadorServicoCte

  valorPrestacao Decimal @default(0)
  valorReceber   Decimal @default(0)

  valorCarga                 Decimal @default(0)
  produtoPredominante        String
  outrasCaracteristicasCarga String?
  valorCargaAverbacao        Decimal?

  rntrc String?

  informacoesAdicionais String?
  informacoesFisco      String?

  chaveCteReferenciado String?

  // ICMS do serviço de transporte.
  grupoIcms          GrupoIcmsCte @default(ICMSSN)
  cstIcms            String       @default("90")
  percentualReducaoBc Decimal?
  baseCalculoIcms     Decimal?
  aliquotaIcms        Decimal?
  valorIcms           Decimal?
  valorCreditoIcms    Decimal?
  baseCalculoStRetido Decimal?
  aliquotaStRetido    Decimal?
  valorIcmsStRetido   Decimal?
  codigoBeneficioFiscal String?
  valorTotalTributos    Decimal?

  // DIFAL / FCP quando aplicável à prestação interestadual.
  baseCalculoUfFim Decimal?
  percentualFcpUfFim Decimal?
  percentualIcmsUfFim Decimal?
  percentualIcmsInterestadual Decimal?
  valorFcpUfFim Decimal?
  valorIcmsUfFim Decimal?
  valorIcmsUfInicio Decimal?

  // Reforma Tributária do Consumo (NT 2025.001 / 2026.002).
  cstIbsCbs        String?
  classificacaoTributariaIbsCbs String?
  baseCalculoIbsCbs Decimal?
  aliquotaIbsUf     Decimal?
  valorIbsUf        Decimal?
  aliquotaIbsMunicipio Decimal?
  valorIbsMunicipio Decimal?
  valorIbs          Decimal?
  aliquotaCbs       Decimal?
  valorCbs          Decimal?
  valorTotalDfe     Decimal?

  numeroAleatorio String?
  chaveAcesso     String?
  qrCode          String?

  protocoloAutorizacao String?
  dataAutorizacao      DateTime?
  codigoStatusSefaz    String?
  motivoStatusSefaz    String?
  versaoAplicacaoSefaz String?
  motivoRejeicao       String?

  protocoloCancelamento String?
  dataCancelamento      DateTime?

  xmlGerado            String?
  xmlAssinado          String?
  xmlAutorizado        String?
  xmlRetornoSefaz      String?
  xmlEventoCancelamento String?

  participantes    ParticipanteCte[]
  documentosNfe    DocumentoNfeCte[]
  quantidadesCarga QuantidadeCargaCte[]
  componentesValor ComponenteValorCte[]
  pagamentosVinculados PagamentoVinculadoCte[]
  eventos           EventoCte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero, serie])
  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, dataEmissao])
  @@index([chaveAcesso])
}

model ParticipanteCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  papel PapelParticipanteCte

  tipoPessoa TipoPessoa
  cpfCnpj    String
  inscricaoEstadual String?
  nome String
  nomeFantasia String?

  telefone String?
  email    String?

  logradouro       String
  numero           String
  complemento      String?
  bairro           String
  codigoMunicipio  String
  municipio        String
  cep              String?
  uf               String
  codigoPais       String @default("1058")
  pais             String @default("BRASIL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cteId, papel])
  @@index([cteId])
  @@index([cpfCnpj])
}

model DocumentoNfeCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  chaveAcesso String

  createdAt DateTime @default(now())

  @@unique([cteId, chaveAcesso])
  @@index([cteId])
  @@index([chaveAcesso])
}

model QuantidadeCargaCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  unidade UnidadeMedidaCte
  tipoMedida String
  quantidade Decimal

  createdAt DateTime @default(now())

  @@index([cteId])
}

model ComponenteValorCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  nome  String
  valor Decimal

  createdAt DateTime @default(now())

  @@index([cteId])
}

model PagamentoVinculadoCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  numeroPagamento Int
  idTransacao     String
  tipoMeioPagamento String
  cnpjRecebedor      String
  cnpjBasePsp        String

  createdAt DateTime @default(now())

  @@unique([cteId, numeroPagamento])
  @@unique([cteId, idTransacao])
  @@index([cteId])
}

model EventoCte {
  id String @id @default(cuid())

  cteId String
  cte   ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tipo      TipoEventoCte
  sequencia Int @default(1)
  status    StatusEventoCte @default(PENDENTE)

  codigoStatus String?
  motivo       String?
  protocolo    String?

  xmlEnvio   String?
  xmlRetorno String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cteId, tipo, sequencia])
  @@index([cteId])
  @@index([cteId, tipo])
}
