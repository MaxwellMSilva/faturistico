model PagamentoNotaFiscal {
  id String @id @default(cuid())

  notaFiscalId String
  notaFiscal   NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  indicador IndicadorPagamento @default(A_VISTA)

  // Código tPag conforme tabela vigente da NF-e.
  meioPagamento String

  valor Decimal @default(0)

  // Obrigatório quando meioPagamento = 99 (Outros).
  descricaoMeioPagamento String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notaFiscalId])
}
